68, "e": 34.158}, {"w": "rejected", "s": 34.19, "e": 34.626}, {"w": "friends", "s": 34.674, "e": 35.061}, {"w": "slip", "s": 35.104, "e": 35.346}, {"w": "back", "s": 35.373, "e": 35.615}, {"w": "in", "s": 35.642, "e": 35.787}, {"w": "with", "s": 35.803, "e": 36.045}, {"w": "them.", "s": 36.072, "e": 36.362}]}, {"start": 36.694495412844034, "end": 40.67284403669726, "text": "So every hand gets stamped with invisible ink that glows under a UV lamp.", "words": [{"w": "So", "s": 36.694, "e": 36.84}, {"w": "every", "s": 36.856, "e": 37.146}, {"w": "hand", "s": 37.178, "e": 37.42}, {"w": "gets", "s": 37.447, "e": 37.689}, {"w": "stamped", "s": 37.716, "e": 38.103}, {"w": "with", "s": 38.146, "e": 38.388}, {"w": "invisible", "s": 38.415, "e": 38.899}, {"w": "ink", "s": 38.952, "e": 39.146}, {"w": "that", "s": 39.168, "e": 39.409}, {"w": "glows", "s": 39.436, "e": 39.727}, {"w": "under", "s": 39.759, "e": 40.049}, {"w": "a", "s": 40.081, "e": 40.178}, {"w": "UV", "s": 40.189, "e": 40.334}, {"w": "lamp.", "s": 40.35, "e": 40.641}]}, {"start": 40.97284403669726, "end": 43.7684403669725, "text": "Then someone pushes the fire exit open from inside.", "words": [{"w": "Then", "s": 40.973, "e": 41.215}, {"w": "someone", "s": 41.242, "e": 41.629}, {"w": "pushes", "s": 41.672, "e": 42.01}, {"w": "the", "s": 42.048, "e": 42.242}, {"w": "fire", "s": 42.263, "e": 42.505}, {"w": "exit", "s": 42.532, "e": 42.774}, {"w": "open", "s": 42.801, "e": 43.043}, {"w": "from", "s": 43.07, "e": 43.311}, {"w": "inside.", "s": 43.338, "e": 43.725}]}, {"start": 44.068440366972496, "end": 49.92844036697252, "text": "So every fire exit gets an alarm, wired to the sound system, so in a real fire the music cuts out instantly.", "words": [{"w": "So", "s": 44.068, "e": 44.214}, {"w": "every", "s": 44.23, "e": 44.52}, {"w": "fire", "s": 44.552, "e": 44.794}, {"w": "exit", "s": 44.821, "e": 45.063}, {"w": "gets", "s": 45.09, "e": 45.332}, {"w": "an", "s": 45.359, "e": 45.504}, {"w": "alarm,", "s": 45.52, "e"