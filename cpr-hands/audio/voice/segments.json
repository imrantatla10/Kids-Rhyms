[{"start": 0.35, "end": 2.4877777777777776, "text": "Someone drops right in front of you.", "words": [{"w": "Someone", "s": 0.35, "e": 0.766}, {"w": "drops", "s": 0.812, "e": 1.124}, {"w": "right", "s": 1.159, "e": 1.471}, {"w": "in", "s": 1.506, "e": 1.662}, {"w": "front", "s": 1.679, "e": 1.991}, {"w": "of", "s": 2.026, "e": 2.182}, {"w": "you.", "s": 2.199, "e": 2.459}]}, {"start": 2.7877777777777775, "end": 3.3655555555555554, "text": "No pulse.", "words": [{"w": "No", "s": 2.788, "e": 2.944}, {"w": "pulse.", "s": 2.961, "e": 3.325}]}, {"start": 3.6655555555555552, "end": 4.301111111111111, "text": "No breath.", "words": [{"w": "No", "s": 3.666, "e": 3.822}, {"w": "breath.", "s": 3.839, "e": 4.255}]}, {"start": 4.601111111111111, "end": 6.796666666666666, "text": "Their brain has about four minutes...", "words": [{"w": "Their", "s": 4.601, "e": 4.913}, {"w": "brain", "s": 4.948, "e": 5.26}, {"w": "has", "s": 5.294, "e": 5.502}, {"w": "about", "s": 5.526, "e": 5.838}, {"w": "four", "s": 5.872, "e": 6.132}, {"w": "minutes...", "s": 6.161, "e": 6.733}]}, {"start": 7.096666666666666, "end": 9.465555555555554, "text": "and the ambulance is eight minutes away.", "words": [{"w": "and", "s": 7.097, "e": 7.305}, {"w": "the", "s": 7.328, "e": 7.536}, {"w": "ambulance", "s": 7.559, "e": 8.079}, {"w": "is", "s": 8.137, "e": 8.293}, {"w": "eight", "s": 8.31, "e": 8.622}, {"w": "minutes", "s": 8.657, "e": 9.073}, {"w": "away.", "s": 9.119, "e": 9.431}]}, {"start": 9.765555555555554, "end": 12.018888888888892, "text": "What you do next decides if they live.", "words": [{"w": "What", "s": 9.766, "e": 10.026}, {"w": "you", "s": 10.054, "e": 10.262}, {"w": "do", "s": 10.286, "e": 10.442}, {"w": "next", "s": 10.459, "e": 10.719}, {"w": "decides", "s": 10.748, "e": 11.164}, {"w": "if", "s": 11.21, "e": 11.366}, {"w": "they", "s": 11.383, "e": 11.643}, {"w": "live.", "s": 11.672, "e": 11.984}]}, {"start": 12.318888888888893, "end": 13.70555555555556, "text": "This is cardiac arrest.", "words": [{"w": "This", "s": 12.319, "e": 12.579}, {"w": "is", "s": 12.608, "e": 12.764}, {"w": "cardiac", "s": 12.781, "e": 13.197}, {"w": "arrest.", "s": 13.243, "e": 13.659}]}, {"start": 14.00555555555556, "end": 18.281111111111116, "text": "The heart's wiring goes haywire, it just quivers, and blood stops moving.", "words": [{"w": "The", "s": 14.006, "e": 14.214}, {"w": "heart's", "s": 14.237, "e": 14.653}, {"w": "wiring", "s": 14.699, "e": 15.063}, {"w": "goes", "s": 15.103, "e": 15.363}, {"w": "haywire,", "s": 15.392, "e": 15.86}, {"w": "it", "s": 15.912, "e": 16.068}, {"w": "just", "s": 16.086, "e": 16.346}, {"w": "quivers,", "s": 16.374, "e": 16.842}, {"w": "and", "s": 16.894, "e": 17.102}, {"w": "blood", "s": 17.126, "e": 17.438}, {"w": "stops", "s": 17.472, "e": 17.784}, {"w": "moving.", "s": 17.819, "e": 18.235}]}, {"start": 18.581111111111117, "end": 20.198888888888895, "text": "But your hands can move it.", "words": [{"w": "But", "s": 18.581, "e": 18.789}, {"w": "your", "s": 18.812, "e": 19.072}, {"w": "hands", "s": 19.101, "e": 19.413}, {"w": "can", "s": 19.448, "e": 19.656}, {"w": "move", "s": 19.679, "e": 19.939}, {"w": "it.", "s": 19.968, "e": 20.176}]}, {"start": 20.498888888888896, "end": 22.29000000000001, "text": "CPR doesn't restart the heart.", "words": [{"w": "CPR", "s": 20.499, "e": 20.707}, {"w": "doesn't", "s": 20.73, "e": 21.146}, {"w": "restart", "s": 21.192, "e": 21.608}, {"w": "the", "s": 21.654, "e": 21.862}, {"w": "heart.", "s": 21.886, "e": 22.25}]}, {"start": 22.59000000000001, "end": 23.86111111111112, "text": "You become the heart.", "words": [{"w": "You", "s": 22.59, "e": 22.798}, {"w": "become", "s": 22.821, "e": 23.185}, {"w": "the", "s": 23.226, "e": 23.434}, {"w": "heart.", "s": 23.457, "e": 23.821}]}, {"start": 24.161111111111122, "end": 28.610000000000014, "text": "Push down, and you squeeze it against the spine, sending blood to the brain.", "words": [{"w": "Push", "s": 24.161, "e": 24.421}, {"w": "down,", "s": 24.45, "e": 24.762}, {"w": "and", "s": 24.797, "e": 25.005}, {"w": "you", "s": 25.028, "e": 25.236}, {"w": "squeeze", "s": 25.259, "e": 25.675}, {"w": "it", "s": 25.721, "e": 25.877}, {"w": "against", "s": 25.894, "e": 26.31}, {"w": "the", "s": 26.357, "e": 26.565}, {"w": "spine,", "s": 26.588, "e": 26.952}, {"w": "sending", "s": 26.992, "e": 27.408}, {"w": "blood", "s": 27.454, "e": 27.766}, {"w": "to", "s": 27.801, "e": 27.957}, {"w": "the", "s": 27.974, "e": 28.182}, {"w": "brain.", "s": 28.206, "e": 28.57}]}, {"start": 28.910000000000014, "end": 30.29666666666668, "text": "Let go, and it refills.", "words": [{"w": "Let", "s": 28.91, "e": 29.118}, {"w": "go,", "s": 29.141, "e": 29.349}, {"w": "and", "s": 29.372, "e": 29.58}, {"w": "it", "s": 29.603, "e": 29.759}, {"w": "refills.", "s": 29.777, "e": 30.245}]}, {"start": 30.596666666666682, "end": 32.44555555555557, "text": "First, call emergency services.", "words": [{"w": "First,", "s": 30.597, "e": 30.961}, {"w": "call", "s": 31.001, "e": 31.261}, {"w": "emergency", "s": 31.29, "e": 31.81}, {"w": "services.", "s": 31.868, "e": 32.388}]}, {"start": 32.74555555555557, "end": 33.78555555555557, "text": "Phone on speaker.", "words": [{"w": "Phone", "s": 32.746, "e": 33.058}, {"w": "on", "s": 33.092, "e": 33.248}, {"w": "speaker.", "s": 33.266, "e": 33.734}]}, {"start": 34.085555555555565, "end": 37.783333333333346, "text": "Heel of one hand in the center of the chest, other hand on top.", "words": [{"w": "Heel", "s": 34.086, "e": 34.346}, {"w": "of", "s": 34.374, "e": 34.53}, {"w": "one", "s": 34.548, "e": 34.756}, {"w": "hand", "s": 34.779, "e": 35.039}, {"w": "in", "s": 35.068, "e": 35.224}, {"w": "the", "s": 35.241, "e": 35.449}, {"w": "center", "s": 35.472, "e": 35.836}, {"w": "of", "s": 35.877, "e": 36.033}, {"w": "the", "s": 36.05, "e": 36.258}, {"w": "chest,", "s": 36.281, "e": 36.645}, {"w": "other", "s": 36.686, "e": 36.998}, {"w": "hand", "s": 37.032, "e": 37.292}, {"w": "on", "s": 37.321, "e": 37.477}, {"w": "top.", "s": 37.494, "e": 37.754}]}, {"start": 38.08333333333334, "end": 39.12333333333335, "text": "Lock your elbows.", "words": [{"w": "Lock", "s": 38.083, "e": 38.343}, {"w": "your", "s": 38.372, "e": 38.632}, {"w": "elbows.", "s": 38.661, "e": 39.077}]}, {"start": 39.423333333333346, "end": 41.387777777777785, "text": "Push hard, about two inches deep.", "words": [{"w": "Push", "s": 39.423, "e": 39.683}, {"w": "hard,", "s": 39.712, "e": 40.024}, {"w": "about", "s": 40.059, "e": 40.371}, {"w": "two", "s": 40.406, "e": 40.614}, {"w": "inches", "s": 40.637, "e": 41.001}, {"w": "deep.", "s": 41.041, "e": 41.353}]}, {"start": 41.68777777777778, "end": 42.034444444444446, "text": "Fast.", "words": [{"w": "Fast.", "s": 41.688, "e": 42.0}]}, {"start": 42.33444444444444, "end": 45.22333333333332, "text": "A hundred to a hundred and twenty times a minute.", "words": [{"w": "A", "s": 42.334, "e": 42.438}, {"w": "hundred", "s": 42.45, "e": 42.866}, {"w": "to", "s": 42.912, "e": 43.068}, {"w": "a", "s": 43.086, "e": 43.19}, {"w": "hundred", "s": 43.201, "e": 43.617}, {"w": "and", "s": 43.663, "e": 43.871}, {"w": "twenty", "s": 43.894, "e": 44.258}, {"w": "times", "s": 44.299, "e": 44.611}, {"w": "a", "s": 44.646, "e": 44.75}, {"w": "minute.", "s": 44.761, "e": 45.177}]}, {"start": 45.52333333333332, "end": 47.487777777777765, "text": "That's the beat of Stayin' Alive.", "words": [{"w": "That's", "s": 45.523, "e": 45.887}, {"w": "the", "s": 45.928, "e": 46.136}, {"w": "beat", "s": 46.159, "e": 46.419}, {"w": "of", "s": 46.448, "e": 46.604}, {"w": "Stayin'", "s": 46.621, "e": 47.037}, {"w": "Alive.", "s": 47.083, "e": 47.447}]}, {"start": 47.78777777777776, "end": 48.53888888888888, "text": "Not trained?", "words": [{"w": "Not", "s": 47.788, "e": 47.996}, {"w": "trained?", "s": 48.019, "e": 48.487}]}, {"start": 48.838888888888874, "end": 49.87888888888888, "text": "Skip the breaths.", "words": [{"w": "Skip", "s": 48.839, "e": 49.099}, {"w": "the", "s": 49.128, "e": 49.336}, {"w": "breaths.", "s": 49.359, "e": 49.827}]}, {"start": 50.17888888888888, "end": 50.81444444444443, "text": "Just push.", "words": [{"w": "Just", "s": 50.179, "e": 50.439}, {"w": "push.", "s": 50.468, "e": 50.78}]}, {"start": 51.11444444444443, "end": 52.15444444444444, "text": "Then grab an AED.", "words": [{"w": "Then", "s": 51.114, "e": 51.374}, {"w": "grab", "s": 51.403, "e": 51.663}, {"w": "an", "s": 51.692, "e": 51.848}, {"w": "AED.", "s": 51.866, "e": 52.126}]}, {"start": 52.454444444444434, "end": 56.38333333333332, "text": "It stops the quivering, so the heart can find its own rhythm again.", "words": [{"w": "It", "s": 52.454, "e": 52.61}, {"w": "stops", "s": 52.628, "e": 52.94}, {"w": "the", "s": 52.974, "e": 53.182}, {"w": "quivering,", "s": 53.206, "e": 53.778}, {"w": "so", "s": 53.841, "e": 53.997}, {"w": "the", "s": 54.014, "e": 54.222}, {"w": "heart", "s": 54.246, "e": 54.558}, {"w": "can", "s": 54.592, "e": 54.8}, {"w": "find", "s": 54.823, "e": 55.083}, {"w": "its", "s": 55.112, "e": 55.32}, {"w": "own", "s": 55.343, "e": 55.551}, {"w": "rhythm", "s": 55.574, "e": 55.938}, {"w": "again.", "s": 55.979, "e": 56.343}]}, {"start": 56.683333333333316, "end": 59.10999999999998, "text": "Your hands keep them alive until it does.", "words": [{"w": "Your", "s": 56.683, "e": 56.943}, {"w": "hands", "s": 56.972, "e": 57.284}, {"w": "keep", "s": 57.319, "e": 57.579}, {"w": "them", "s": 57.608, "e": 57.868}, {"w": "alive", "s": 57.897, "e": 58.209}, {"w": "until", "s": 58.243, "e": 58.555}, {"w": "it", "s": 58.59, "e": 58.746}, {"w": "does.", "s": 58.763, "e": 59.075}]}, {"start": 59.409999999999975, "end": 60.21888888888886, "text": "Now you know.", "words": [{"w": "Now", "s": 59.41, "e": 59.618}, {"w": "you", "s": 59.641, "e": 59.849}, {"w": "know.", "s": 59.872, "e": 60.184}]}, {"start": 60.51888888888886, "end": 61.21222222222219, "text": "Share this.", "words": [{"w": "Share", "s": 60.519, "e": 60.831}, {"w": "this.", "s": 60.866, "e": 61.178}]}, {"start": 61.512222222222185, "end": 62.78333333333329, "text": "It could save a life.", "words": [{"w": "It", "s": 61.512, "e": 61.668}, {"w": "could", "s": 61.686, "e": 61.998}, {"w": "save", "s": 62.032, "e": 62.292}, {"w": "a", "s": 62.321, "e": 62.425}, {"w": "life.", "s": 62.437, "e": 62.749}]}]