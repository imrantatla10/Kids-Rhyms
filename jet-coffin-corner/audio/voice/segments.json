[{"start": 0.3, "end": 1.9718023255813957, "text": "Thirty-five thousand feet.", "words": [{"w": "Thirty-five", "s": 0.3, "e": 0.969}, {"w": "thousand", "s": 1.043, "e": 1.545}, {"w": "feet.", "s": 1.6, "e": 1.935}]}, {"start": 2.3218023255813955, "end": 4.984302325581396, "text": "A private jet, cruising through the night.", "words": [{"w": "A", "s": 2.322, "e": 2.433}, {"w": "private", "s": 2.446, "e": 2.891}, {"w": "jet,", "s": 2.941, "e": 3.22}, {"w": "cruising", "s": 3.251, "e": 3.752}, {"w": "through", "s": 3.808, "e": 4.254}, {"w": "the", "s": 4.303, "e": 4.526}, {"w": "night.", "s": 4.551, "e": 4.941}]}, {"start": 5.334302325581396, "end": 6.882267441860466, "text": "Seventy seconds later...", "words": [{"w": "Seventy", "s": 5.334, "e": 5.78}, {"w": "seconds", "s": 5.83, "e": 6.275}, {"w": "later...", "s": 6.325, "e": 6.827}]}, {"start": 7.232267441860466, "end": 7.9133720930232565, "text": "it's gone.", "words": [{"w": "it's", "s": 7.232, "e": 7.511}, {"w": "gone.", "s": 7.542, "e": 7.876}]}, {"start": 8.263372093023257, "end": 9.130232558139536, "text": "No explosion.", "words": [{"w": "No", "s": 8.263, "e": 8.431}, {"w": "explosion.", "s": 8.449, "e": 9.062}]}, {"start": 9.480232558139535, "end": 10.656686046511629, "text": "No engine failure.", "words": [{"w": "No", "s": 9.48, "e": 9.647}, {"w": "engine", "s": 9.666, "e": 10.056}, {"w": "failure.", "s": 10.099, "e": 10.601}]}, {"start": 11.006686046511629, "end": 13.421511627906979, "text": "So what can pull a jet out of the sky?", "words": [{"w": "So", "s": 11.007, "e": 11.174}, {"w": "what", "s": 11.192, "e": 11.471}, {"w": "can", "s": 11.502, "e": 11.725}, {"w": "pull", "s": 11.75, "e": 12.028}, {"w": "a", "s": 12.059, "e": 12.171}, {"w": "jet", "s": 12.183, "e": 12.406}, {"w": "out", "s": 12.431, "e": 12.654}, {"w": "of", "s": 12.678, "e": 12.846}, {"w": "the", "s": 12.864, "e": 13.087}, {"w": "sky?", "s": 13.112, "e": 13.391}]}, {"start": 13.771511627906978, "end": 18.291569767441864, "text": "Up here, the air is so thin that a jet flies inside a tiny speed window.", "words": [{"w": "Up", "s": 13.772, "e": 13.939}, {"w": "here,", "s": 13.957, "e": 14.292}, {"w": "the", "s": 14.329, "e": 14.552}, {"w": "air", "s": 14.576, "e": 14.799}, {"w": "is", "s": 14.824, "e": 14.991}, {"w": "so", "s": 15.01, "e": 15.177}, {"w": "thin", "s": 15.196, "e": 15.474}, {"w": "that", "s": 15.505, "e": 15.784}, {"w": "a", "s": 15.815, "e": 15.926}, {"w": "jet", "s": 15.939, "e": 16.162}, {"w": "flies", "s": 16.186, "e": 16.521}, {"w": "inside", "s": 16.558, "e": 16.948}, {"w": "a", "s": 16.991, "e": 17.103}, {"w": "tiny", "s": 17.115, "e": 17.394}, {"w": "speed", "s": 17.425, "e": 17.759}, {"w": "window.", "s": 17.796, "e": 18.242}]}, {"start": 18.641569767441865, "end": 20.994476744186045, "text": "Too slow, and the wing stops lifting.", "words": [{"w": "Too", "s": 18.642, "e": 18.864}, {"w": "slow,", "s": 18.889, "e": 19.224}, {"w": "and", "s": 19.261, "e": 19.484}, {"w": "the", "s": 19.508, "e": 19.731}, {"w": "wing", "s": 19.756, "e": 20.035}, {"w": "stops", "s": 20.066, "e": 20.4}, {"w": "lifting.", "s": 20.437, "e": 20.939}]}, {"start": 21.344476744186046, "end": 24.37848837209302, "text": "Too fast, and shockwaves tear the airflow apart.", "words": [{"w": "Too", "s": 21.344, "e": 21.567}, {"w": "fast,", "s": 21.592, "e": 21.927}, {"w": "and", "s": 21.964, "e": 22.187}, {"w": "shockwaves", "s": 22.211, "e": 22.824}, {"w": "tear", "s": 22.892, "e": 23.171}, {"w": "the", "s": 23.202, "e": 23.425}, {"w": "airflow", "s": 23.45, "e": 23.896}, {"w": "apart.", "s": 23.945, "e": 24.335}]}, {"start": 24.72848837209302, "end": 26.83372093023256, "text": "Pilots call it the coffin corner.", "words": [{"w": "Pilots", "s": 24.728, "e": 25.119}, {"w": "call", "s": 25.162, "e": 25.441}, {"w": "it", "s": 25.472, "e": 25.639}, {"w": "the", "s": 25.657, "e": 25.88}, {"w": "coffin", "s": 25.905, "e": 26.295}, {"w": "corner.", "s": 26.338, "e": 26.784}]}, {"start": 27.18372093023256, "end": 27.988662790697674, "text": "Now add ice.", "words": [{"w": "Now", "s": 27.184, "e": 27.407}, {"w": "add", "s": 27.431, "e": 27.654}, {"w": "ice.", "s": 27.679, "e": 27.958}]}, {"start": 28.338662790697676, "end": 33.04447674418605, "text": "A thin crust, rough as sandpaper, can steal a huge part of the wing's lift.", "words": [{"w": "A", "s": 28.339, "e": 28.45}, {"w": "thin", "s": 28.463, "e": 28.741}, {"w": "crust,", "s": 28.772, "e": 29.162}, {"w": "rough", "s": 29.206, "e": 29.54}, {"w": "as", "s": 29.577, "e": 29.744}, {"w": "sandpaper,", "s": 29.763, "e": 30.376}, {"w": "can", "s": 30.444, "e": 30.667}, {"w": "steal", "s": 30.692, "e": 31.026}, {"w": "a", "s": 31.063, "e": 31.175}, {"w": "huge", "s": 31.187, "e": 31.466}, {"w": "part", "s": 31.497, "e": 31.775}, {"w": "of", "s": 31.806, "e": 31.973}, {"w": "the", "s": 31.992, "e": 32.215}, {"w": "wing's", "s": 32.24, "e": 32.63}, {"w": "lift.", "s": 32.673, "e": 33.007}]}, {"start": 33.39447674418605, "end": 34.63284883720931, "text": "The window shrinks.", "words": [{"w": "The", "s": 33.394, "e": 33.617}, {"w": "window", "s": 33.642, "e": 34.032}, {"w": "shrinks.", "s": 34.076, "e": 34.577}]}, {"start": 34.98284883720931, "end": 36.34505813953489, "text": "Then turbulence hits.", "words": [{"w": "Then", "s": 34.983, "e": 35.261}, {"w": "turbulence", "s": 35.292, "e": 35.905}, {"w": "hits.", "s": 35.974, "e": 36.308}]}, {"start": 36.69505813953489, "end": 37.74767441860466, "text": "One hard jolt...", "words": [{"w": "One", "s": 36.695, "e": 36.918}, {"w": "hard", "s": 36.943, "e": 37.221}, {"w": "jolt...", "s": 37.252, "e": 37.698}]}, {"start": 38.09767441860466, "end": 39.39796511627908, "text": "and the wing stalls.", "words": [{"w": "and", "s": 38.098, "e": 38.321}, {"w": "the", "s": 38.345, "e": 38.568}, {"w": "wing", "s": 38.593, "e": 38.872}, {"w": "stalls.", "s": 38.903, "e": 39.348}]}, {"start": 39.74796511627908, "end": 40.73866279069769, "text": "The nose drops.", "words": [{"w": "The", "s": 39.748, "e": 39.971}, {"w": "nose", "s": 39.996, "e": 40.274}, {"w": "drops.", "s": 40.305, "e": 40.695}]}, {"start": 41.08866279069769, "end": 45.11337209302327, "text": "The jet falls faster and faster, thousands of feet every minute.", "words": [{"w": "The", "s": 41.089, "e": 41.312}, {"w": "jet", "s": 41.336, "e": 41.559}, {"w": "falls", "s": 41.584, "e": 41.918}, {"w": "faster", "s": 41.956, "e": 42.346}, {"w": "and", "s": 42.389, "e": 42.612}, {"w": "faster,", "s": 42.637, "e": 43.082}, {"w": "thousands", "s": 43.132, "e": 43.689}, {"w": "of", "s": 43.751, "e": 43.918}, {"w": "feet", "s": 43.937, "e": 44.216}, {"w": "every", "s": 44.247, "e": 44.581}, {"w": "minute.", "s": 44.618, "e": 45.064}]}, {"start": 45.463372093023274, "end": 48.49738372093025, "text": "The pilots fight to pull out, racing the ground.", "words": [{"w": "The", "s": 45.463, "e": 45.686}, {"w": "pilots", "s": 45.711, "e": 46.101}, {"w": "fight", "s": 46.144, "e": 46.479}, {"w": "to", "s": 46.516, "e": 46.683}, {"w": "pull", "s": 46.702, "e": 46.98}, {"w": "out,", "s": 47.011, "e": 47.29}, {"w": "racing", "s": 47.321, "e": 47.711}, {"w": "the", "s": 47.754, "e": 47.977}, {"w": "ground.", "s": 48.002, "e": 48.448}]}, {"start": 48.84738372093025, "end": 49.528488372093044, "text": "It's rare.", "words": [{"w": "It's", "s": 48.847, "e": 49.126}, {"w": "rare.", "s": 49.157, "e": 49.491}]}, {"start": 49.878488372093045, "end": 53.22209302325584, "text": "Jets have warnings, de-icing, and well-trained crews.", "words": [{"w": "Jets", "s": 49.878, "e": 50.157}, {"w": "have", "s": 50.188, "e": 50.467}, {"w": "warnings,", "s": 50.498, "e": 51.055}, {"w": "de-icing,", "s": 51.117, "e": 51.674}, {"w": "and", "s": 51.736, "e": 51.959}, {"w": "well-trained", "s": 51.984, "e": 52.708}, {"w": "crews.", "s": 52.789, "e": 53.179}]}, {"start": 53.57209302325584, "end": 57.28720930232561, "text": "But when ice, turbulence, and that narrow window line up...", "words": [{"w": "But", "s": 53.572, "e": 53.795}, {"w": "when", "s": 53.82, "e": 54.098}, {"w": "ice,", "s": 54.129, "e": 54.408}, {"w": "turbulence,", "s": 54.439, "e": 55.108}, {"w": "and", "s": 55.182, "e": 55.405}, {"w": "that", "s": 55.43, "e": 55.708}, {"w": "narrow", "s": 55.739, "e": 56.129}, {"w": "window", "s": 56.173, "e": 56.563}, {"w": "line", "s": 56.606, "e": 56.885}, {"w": "up...", "s": 56.916, "e": 57.25}]}, {"start": 57.63720930232561, "end": 59.86627906976748, "text": "the sky can turn deadly in seconds.", "words": [{"w": "the", "s": 57.637, "e": 57.86}, {"w": "sky", "s": 57.885, "e": 58.108}, {"w": "can", "s": 58.133, "e": 58.355}, {"w": "turn", "s": 58.38, "e": 58.659}, {"w": "deadly", "s": 58.69, "e": 59.08}, {"w": "in", "s": 59.123, "e": 59.29}, {"w": "seconds.", "s": 59.309, "e": 59.811}]}, {"start": 60.21627906976748, "end": 63.49796511627911, "text": "Follow for more, and send this to someone who flies.", "words": [{"w": "Follow", "s": 60.216, "e": 60.606}, {"w": "for", "s": 60.65, "e": 60.873}, {"w": "more,", "s": 60.897, "e": 61.232}, {"w": "and", "s": 61.269, "e": 61.492}, {"w": "send", "s": 61.517, "e": 61.795}, {"w": "this", "s": 61.826, "e": 62.105}, {"w": "to", "s": 62.136, "e": 62.303}, {"w": "someone", "s": 62.322, "e": 62.767}, {"w": "who", "s": 62.817, "e": 63.04}, {"w": "flies.", "s": 63.065, "e": 63.455}]}]